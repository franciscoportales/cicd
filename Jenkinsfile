pipeline {
    agent any

    stages {
        stage('Inicio') {
            steps {
                echo 'Jenkins conectado con GitHub correctamente'
            }
        }

        stage('Prueba') {
            steps {
                echo 'Ejecutando prueba de CI/CD'
            }
        }

        stage('Final') {
            steps {
                echo 'Pipeline finalizado con éxito'
            }
        }
    }
}
